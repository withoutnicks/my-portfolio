---
const nav = [
  { href: "#sobre-mi", label: "Sobre mí" },
  { href: "#proyectos", label: "Proyectos" },
  { href: "#educacion", label: "Educación" },
  { href: "#habilidades", label: "Habilidades" },
  { href: "#contacto", label: "Contacto" },
];
---

<header class="border-b border-stone-800 py-5">
  <nav aria-label="Navegación principal" class="flex flex-wrap gap-x-6 gap-y-2 text-xs font-medium uppercase tracking-widest text-stone-400">
    {
      nav.map((item) => (
        <a
          href={item.href}
          class="transition-colors hover:text-white"
        >
          {item.label}
        </a>
      ))
    }
  </nav>
</header>
