---
import SubtitleSection from "@/components/SubtitleSection.astro";
---

<section id="educacion" class="border-b border-stone-800 py-12">
  <SubtitleSection title="Educación" />

  <div class="mt-6 flex gap-x-4">
    <div class="flex flex-col items-center gap-2">
      <div class="size-2.5 rounded-full bg-stone-600"></div>
      <div class="w-px flex-1 bg-stone-800"></div>
    </div>

    <div class="pb-6">
      <h3 class="text-base font-semibold text-stone-100">
        Desarrollo de Sistemas de Información &mdash; IDAT
      </h3>
      <p class="mt-1 text-sm text-stone-400">
        Egresado de la carrera técnica de Desarrollo de Sistemas del Instituto de Tecnología
        de la Información y la Comunicación (IDAT) de Lima, Perú.
      </p>
    </div>
  </div>
</section>
