---
import Button from "@/components/Button.astro";
import LinkButton from "@/components/LinkButton.astro";
import Envelope from "@/components/icons/Envelope.astro";
import FileText from "@/components/icons/FileText.astro";

const email = "gcaycho07@gmail.com";
---

<section
  class="grid gap-x-8 gap-y-6 py-16 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center"
>
  <div>
    <h1 class="text-3xl font-bold text-stone-100">Gerardo Caycho Artiaga</h1>
    <p class="mt-3 text-sm font-medium text-stone-400">
      Web &amp; Apps Developer &middot; Lima, Perú
    </p>

    <p
      class="mt-5 max-w-[45ch] text-base text-pretty leading-relaxed text-stone-300"
    >
      Enfocado en desarrollar soluciones digitales que mejoran la vida de las
      personas.
    </p>

    <div class="mt-6 flex flex-wrap gap-3 text-sm">
      <Button id="btnCopyEmail" data-email={email}>
        <Envelope />
        <span id="copyEmailLabel">Copiar Email</span>
      </Button>
      <LinkButton href="/cv_gcaycho.pdf" variant="primary">
        <FileText />
        Ver CV
      </LinkButton>
    </div>
  </div>

  <img
    src="/profile.webp"
    alt="Gerardo Caycho"
    width="96"
    height="96"
    class="order-first aspect-square rounded-sm object-cover grayscale sm:order-last sm:w-36"
    loading="eager"
  />
</section>

<script>
  const btn = document.querySelector<HTMLButtonElement>("#btnCopyEmail");
  const label = document.querySelector<HTMLSpanElement>("#copyEmailLabel");

  btn?.addEventListener("click", async () => {
    const email = btn.dataset.email;
    if (!email || !label) return;

    try {
      await navigator.clipboard.writeText(email);
      label.textContent = "Copiado";
      setTimeout(() => {
        label.textContent = "Copiar Email";
      }, 2000);
    } catch {
      label.textContent = email;
    }
  });
</script>
